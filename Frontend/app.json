{
  "expo": {
    "name": "SACI",
    "slug": "SACI",
    "version": "1.1.0",
    "web": {
      "favicon": "./src/assets/Icon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-video",
      "expo-font"
    ],
    "orientation": "portrait",
    "icon": "./src/assets/Icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/BackgroundPapel.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.diego.saci",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/Icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "extra": {
      "eas": {
        "projectId": "70f0612a-ded3-4669-bfbe-e539071a5cc1"
      }
    }
  }
}