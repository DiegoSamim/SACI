{
  "expo": {
    "name": "saci",
    "slug": "saci",
    "version": "1.0.0",
    "web": {
      "favicon": "./src/assets/LogoSaci.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": ["expo-video", "expo-font"],
    "orientation": "portrait",
    "icon": "./src/assets/LogoSaci.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/BackgroundPapel.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.diego.saci",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/LogoSaci.png",
        "backgroundColor": "#ffffff"
      }
    },
    "extra": {
      "eas": {
        "projectId": "70f0612a-ded3-4669-bfbe-e539071a5cc1"
      }
    }
  }
}
