{
  "expo": {
    "name": "my-expo-app",
    "slug": "my-expo-app",
    "version": "1.0.0",
    "web": {
      "favicon": "./src/assets/LogoSaci.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-video",
      "expo-font"
    ],
    "orientation": "portrait",
    "icon": "./src/assets/LogoSaci.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/BackgroundPapel.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/LogoSaci.png",
        "backgroundColor": "#ffffff"
      }
    }
  }
}
